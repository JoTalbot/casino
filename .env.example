# Скопируй в .env и замени секреты
POSTGRES_USER=casino
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=casino
POSTGRES_PORT=5432

# JWT для подписи токенов — 64+ случайных символов, например: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-to-at-least-64-chars-long-random

# Токен админки. Пусто = админ-маршруты выключены.
# Сгенерировать: openssl rand -hex 24
ADMIN_TOKEN=

# Режим денег. Только 'demo'. Значение 'real' не запускается:
# нужны лицензия, сертификация RNG, KYC и AML — см. docs/LICENSING.md
MONEY_MODE=demo
GAMBLING_LICENSE_ID=

# Токен бота Telegram — только для проверки подписи initData.
# Никогда не коммитить настоящий токен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://example.org/parts/casino/

# Порты наружу
API_PORT=3000
CLIENT_PORT=8080

# Для локальной разработки без Docker
DATABASE_URL=postgresql://casino:change-me-strong-password@localhost:5432/casino
